RewriteEngine on

# Fichiers ou dossiers reels (css, js, images, pdf, zip, etc): pas de reecriture
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

#----------------------------
# REGLE DE RE-ECRITURE

# ROUTE USERS.LOGIN
# PATTERN /users/login
# TARGET : ?users=login

RewriteRule ^users\/login$ index.php?users=login [L,QSA]

# ROUTE USERS.LOGINFORM
# PATTERN /users/login-form
# TARGET : ?users=login-form

RewriteRule ^users\/login\-form$ index.php?users=login-form [L,QSA]

# ROUTE CONTACT
# PATTERN contact.html
# TARGET : contact.php?contact=show

RewriteRule ^contact.html$ ?contact=show [L,QSA]

# ROUTE TAGS.SHOW
# PATTERN tags/id/slug(title).html
# TARGET : index.php?tags=show&id=x

RewriteRule ^tags\/([1-9][0-9]*)\/[0-9a-z]([a-z0-9\-]*[0-9a-z])*\.html$ index.php?tags=show&id=$1 [L,QSA]

# ROUTE CATEGORIES.SHOW
# PATTERN categories/id/slug(title).html
# TARGET : index.php?categories=show&id=x

RewriteRule ^categories\/([1-9][0-9]*)\/[0-9a-z]([a-z0-9\-]*[0-9a-z])*\.html$ index.php?categories=show&id=$1 [L,QSA]

# ROUTE POSTS.SEARCH.WITH_QUERY
# PATTERN posts/search/term-with-hyphen
# TARGET : index.php?posts=search&query=term with hyphen

RewriteRule ^posts/search/([^/]+)$ index.php?posts=search&query=$1 [L,QSA,B]

# ROUTE POSTS.PAGINATION
# PATTERN page/numero
# TARGET : index.php?page=x

RewriteRule ^page\/([1-9][0-9]*)$ index.php?page=$1 [L,QSA]

# ROUTE POSTS.SHOW
# PATTERN posts/id/slug(title).html
# TARGET : index.php?posts=show&id=x

RewriteRule ^posts\/([1-9][0-9]*)\/[0-9a-z]([a-z0-9\-]*[0-9a-z])*\.html$ index.php?posts=show&id=$1 [L,QSA]

#-----------------------------
# FALLBACK
# toute autre URL non prise en charge retour vers index.php

RewriteRule ^ index.php [L]